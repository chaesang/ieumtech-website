---
import Base from '~/layouts/Base.astro';
import { useTranslations } from '~/i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);

const ACCESS_KEY = 'fb98ecd5-455b-459f-b876-9eb7c9911118';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Chaesang Jung',
  alternateName: '정채상',
  url: 'https://ieumtech.net/hire-me',
  jobTitle: 'Founder, Ieum Tech',
  sameAs: 'https://linkedin.com/in/chaesang',
};
---
<Base
  title="Open to the Right Role — Chaesang Jung"
  description="Chaesang Jung is selectively open to full-time engineering leadership roles. See current availability, what he's looking for, and how to reach out."
  lang={lang}
  path="/hire-me"
  altLangPath="/ko/hire-me"
  jsonLd={jsonLd}
>
  <main>
    <section class="hire-hero">
      <div class="hire-inner">
        <p class="hire-label">Full-time opportunities</p>
        <h1 class="hire-heading">Open to the Right Role</h1>
        <p class="hire-sub">I'm selectively open to full-time leadership opportunities. If you think there's a fit, I'd like to hear about it.</p>
      </div>
    </section>

    <section class="hire-body">
      <div class="hire-inner">

        <div class="hire-block">
          <h2 class="block-label">Availability</h2>
          <div class="availability-row">
            <span class="availability-dot" aria-hidden="true"></span>
            <span class="availability-status">Open — as of mid-2026</span>
          </div>
          <p class="block-text">I'm currently available for full-time roles. I prefer to be deliberate about fit — a short conversation first works best before anything formal.</p>
        </div>

        <div class="hire-block">
          <h2 class="block-label">Roles I'd Consider</h2>
          <ul class="roles-list">
            <li>
              <strong>VP of Engineering</strong>
              <span>Scaling or rebuilding an engineering organization — the kind of role that requires both hands-on credibility and leadership depth.</span>
            </li>
            <li>
              <strong>CTO</strong>
              <span>Early to mid-stage companies where technical strategy and team-building are equally important.</span>
            </li>
            <li>
              <strong>Distinguished / Staff+ Engineer</strong>
              <span>Individual contributor roles with real scope — cross-cutting technical problems, not maintenance work.</span>
            </li>
            <li>
              <strong>Fractional / Part-time CTO</strong>
              <span>For the right company, a structured part-time arrangement while I weigh full-time options.</span>
            </li>
          </ul>
        </div>

        <div class="hire-block">
          <h2 class="block-label">What I'm Looking For</h2>
          <ul class="criteria-list">
            <li>Technology as a core product, not a cost center</li>
            <li>Teams that care about both craft and the people doing the work</li>
            <li>Problems I haven't fully solved before — new domains welcome</li>
            <li>Seoul or Bay Area based; open to hybrid; remote for the right fit</li>
          </ul>
        </div>

        <div class="hire-block">
          <h2 class="block-label">Background in Brief</h2>
          <p class="block-text">Nearly 30 years across embedded systems, search, commerce, fintech, cloud, and industrial AI. Spent 13+ years at Google in Seoul and Silicon Valley, then VP Engineering at Banksalad, CTO at INEEJI, adjunct professor at KAIST. I've built organizations from 0 to 50, and led people inside 60,000-person companies. I've been on both sides of the hire.</p>
          <p class="block-links">
            <a href="/about">Full background</a>
            <a href="/companies">Companies & roles</a>
            <a href="https://linkedin.com/in/chaesang" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </p>
        </div>

        <div class="hire-block" id="contact">
          <h2 class="block-label">Get in Touch</h2>
          <p class="block-text">Tell me about the role and the organization. No deck needed — a few sentences about the problem you're solving and why you think there's a fit is enough to start.</p>

          <form id="hire-form" class="hire-form">
            <input type="hidden" name="access_key" value={ACCESS_KEY} />
            <input type="hidden" name="from_name" value="ieumtech.net" />
            <input type="hidden" name="subject" value="Hire Me inquiry — ieumtech.net" />
            <input type="text" name="botcheck" tabindex="-1" autocomplete="off" class="hire-honeypot" aria-hidden="true" />

            <div class="hire-field">
              <label for="hf-name">Name <span class="req" aria-hidden="true">*</span></label>
              <input id="hf-name" type="text" name="name" required autocomplete="name" />
            </div>

            <div class="hire-field">
              <label for="hf-email">Email <span class="req" aria-hidden="true">*</span></label>
              <input id="hf-email" type="email" name="email" required autocomplete="email" />
              <small>I'll reply here.</small>
            </div>

            <div class="hire-field">
              <label for="hf-company">Company</label>
              <input id="hf-company" type="text" name="company" autocomplete="organization" />
            </div>

            <div class="hire-field">
              <label for="hf-role">Role in mind</label>
              <input id="hf-role" type="text" name="role" placeholder="e.g. VP Engineering, CTO…" />
            </div>

            <div class="hire-field">
              <label for="hf-message">Tell me about the opportunity <span class="req" aria-hidden="true">*</span></label>
              <textarea id="hf-message" name="message" required rows="6" placeholder="Organization, problem you're solving, why you think there's a fit — anything that helps me understand the context."></textarea>
            </div>

            <div class="hire-submit-row">
              <button type="submit" class="btn hire-submit">
                <span class="hire-submit-label" data-default="Send" data-loading="Sending…">Send</span>
              </button>
              <span class="hire-error" id="hire-error" role="alert" hidden>Something went wrong. Please try again, or email hello@ieumtech.net directly.</span>
            </div>
          </form>

          <div id="hire-success" class="hire-success" hidden>
            <h3>Got it.</h3>
            <p>I'll reply at the email you gave, within a few days.</p>
            <p class="hire-signoff">— Chaesang</p>
          </div>
        </div>

      </div>
    </section>
  </main>
</Base>

<script>
  const form = document.getElementById('hire-form') as HTMLFormElement | null;
  const success = document.getElementById('hire-success') as HTMLElement | null;
  const errorEl = document.getElementById('hire-error') as HTMLElement | null;

  if (form && success && errorEl) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const labelEl = form.querySelector<HTMLElement>('.hire-submit-label');
      if (submitBtn && labelEl) {
        submitBtn.disabled = true;
        labelEl.textContent = labelEl.dataset.loading ?? 'Sending…';
      }

      const formData = new FormData(form);
      const role = formData.get('role');
      if (role) {
        formData.set('subject', `Hire Me inquiry — ${role}`);
      }

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          form.hidden = true;
          success.hidden = false;
          success.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          throw new Error(data.message ?? 'request failed');
        }
      } catch {
        errorEl.hidden = false;
        if (submitBtn && labelEl) {
          submitBtn.disabled = false;
          labelEl.textContent = labelEl.dataset.default ?? 'Send';
        }
      }
    });
  }
</script>

<style>
  .hire-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .hire-hero {
    padding: var(--space-8) 0 var(--space-6);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .hire-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-3);
  }
  .hire-heading {
    font-size: 1.875rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 var(--space-4);
    color: var(--color-text);
  }
  .hire-sub {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0;
    max-width: 500px;
  }

  .hire-body {
    padding: var(--space-8) 0 var(--space-11);
  }

  .hire-block {
    padding: var(--space-7) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .hire-block:last-child {
    border-bottom: none;
  }

  .block-label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-subtle);
    margin: 0 0 var(--space-5);
  }

  .availability-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .availability-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
  }
  .availability-status {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .block-text {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-text);
    margin: 0 0 var(--space-4);
  }
  .block-text:last-child { margin-bottom: 0; }

  .block-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .block-links a {
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
  }
  .block-links a:hover { text-decoration: underline; }

  .roles-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .roles-list li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }
  .roles-list strong {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .roles-list span {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .criteria-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .criteria-list li {
    font-size: 0.9375rem;
    color: var(--color-text);
    padding-left: var(--space-5);
    position: relative;
    line-height: 1.6;
  }
  .criteria-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-subtle);
  }

  /* Form */
  .hire-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }
  .hire-form[hidden] { display: none; }

  .hire-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .hire-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hire-field label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.005em;
  }
  .hire-field .req {
    color: var(--color-accent);
    font-weight: 400;
  }
  .hire-field small {
    font-size: 0.8125rem;
    color: var(--color-subtle);
    line-height: 1.5;
  }
  .hire-field input[type="text"],
  .hire-field input[type="email"],
  .hire-field textarea {
    font: inherit;
    font-size: 0.9375rem;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text);
    transition: border-color var(--transition-base);
  }
  .hire-field input:focus,
  .hire-field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  .hire-field textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.6;
  }

  .hire-submit-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  .hire-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .hire-error {
    font-size: 0.875rem;
    color: #c2410c;
    line-height: 1.5;
  }

  .hire-success {
    margin-top: var(--space-6);
    padding: var(--space-6);
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface);
  }
  .hire-success h3 {
    font-size: 1.125rem;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.01em;
  }
  .hire-success p {
    margin: 0 0 var(--space-2);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text);
  }
  .hire-signoff {
    margin-top: var(--space-3) !important;
    color: var(--color-muted) !important;
    font-size: 0.9375rem !important;
  }

  @media (max-width: 639px) {
    .hire-hero { padding: var(--space-7) 0 var(--space-5); }
    .hire-heading { font-size: 1.625rem; }
    .hire-body { padding: var(--space-6) 0 var(--space-9); }
  }
</style>
