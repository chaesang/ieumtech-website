---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import ArtLayout from '~/layouts/ArtLayout.astro';

const all = await getCollection('artworks', (e) => !e.data.draft);

const yearNum = (y: number | string | undefined) =>
  Number(String(y ?? '').slice(0, 4)) || 0;

const works = all.sort((a, b) => {
  const ya = yearNum(a.data.year);
  const yb = yearNum(b.data.year);
  if (ya !== yb) return yb - ya;            // newest year first
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  const oa = a.data.order ?? 9999;
  const ob = b.data.order ?? 9999;
  return oa - ob;                            // within-year curation tiebreak
});
---
<ArtLayout
  title="Hyunhwa Jung — Selected Works"
  description="Selected works by Hyunhwa Jung — paintings, drawings, and studies."
  path="/hyunhwa"
  active="works"
>
  <div class="art-wrap">
    <p class="art-lede">
      A selection of recent paintings, drawings, and studies.
    </p>

    {works.length === 0 ? (
      <p class="art-empty">Works are coming soon.</p>
    ) : (
      <div class="art-grid">
        {works.map((w) => (
          <figure class="art-figure">
            <a href={`/hyunhwa/${w.slug}`}>
              <Image
                src={w.data.image}
                alt={w.data.title}
                widths={[300, 600, 900]}
                sizes="(max-width: 600px) 100vw, 360px"
              />
              <figcaption class="art-cap">
                <span class="t">{w.data.title}</span>
                {(w.data.year || w.data.medium) && (
                  <span class="m">
                    {[w.data.year, w.data.medium].filter(Boolean).join(' · ')}
                  </span>
                )}
                {w.data.placeholder && <span class="art-flag">placeholder</span>}
              </figcaption>
            </a>
          </figure>
        ))}
      </div>
    )}
  </div>
</ArtLayout>
