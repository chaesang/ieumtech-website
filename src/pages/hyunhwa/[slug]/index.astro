---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import ArtLayout from '~/layouts/ArtLayout.astro';

export async function getStaticPaths() {
  const all = await getCollection('artworks', (e) => !e.data.draft);
  const yearNum = (y: number | string | undefined) =>
    Number(String(y ?? '').slice(0, 4)) || 0;
  const works = all.sort((a, b) => {
    const ya = yearNum(a.data.year);
    const yb = yearNum(b.data.year);
    if (ya !== yb) return yb - ya;            // newest year first
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    const oa = a.data.order ?? 9999;
    const ob = b.data.order ?? 9999;
    return oa - ob;
  });

  return works.map((entry, i) => {
    const prev = works[i - 1];
    const next = works[i + 1];
    return {
      params: { slug: entry.slug },
      props: {
        entry,
        prev: prev ? { slug: prev.slug, title: prev.data.title } : null,
        next: next ? { slug: next.slug, title: next.data.title } : null,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await entry.render();
const hasNote = (entry.body ?? '').trim().length > 0;
const metaParts = [d.year, d.medium, d.dimensions].filter(Boolean);
---
<ArtLayout
  title={`${d.title} — Hyunhwa Jung`}
  description={[d.title, d.year, d.medium].filter(Boolean).join(' · ')}
  path={`/hyunhwa/${entry.slug}`}
  active="works"
>
  <article class="art-detail art-wrap">
    <a href="/hyunhwa" class="art-back">← Works</a>

    <div class="art-detail-img">
      <Image
        id="art-main"
        class="zoomable"
        src={d.image}
        alt={d.title}
        widths={[600, 1000, 1600]}
        sizes="(max-width: 900px) 100vw, 900px"
      />
    </div>

    <div class="art-detail-meta">
      <h1>{d.title}</h1>
      {metaParts.length > 0 && (
        <p class="line">{metaParts.map((p) => <span>{p}</span>)}</p>
      )}
      {d.exhibition && <p class="line exhibition">{d.exhibition}</p>}
    </div>

    {hasNote && (
      <div class="art-note">
        <Content />
      </div>
    )}

    {d.installImage && (
      <figure class="art-install">
        <Image
          class="zoomable"
          src={d.installImage}
          alt={`${d.title}, as exhibited`}
          widths={[500, 900]}
          sizes="(max-width: 700px) 100vw, 560px"
        />
        <figcaption>As exhibited</figcaption>
      </figure>
    )}

    {(prev || next) && (
      <nav class="art-pager">
        {prev ? <a class="prev" href={`/hyunhwa/${prev.slug}`}>← {prev.title}</a> : <span></span>}
        {next ? <a class="next" href={`/hyunhwa/${next.slug}`}>{next.title} →</a> : <span></span>}
      </nav>
    )}
  </article>

  <div class="art-lightbox" id="art-lightbox" aria-hidden="true">
    <img id="art-lightbox-img" alt="" />
  </div>

  <script>
    const box = document.getElementById('art-lightbox');
    const boxImg = document.getElementById('art-lightbox-img') as HTMLImageElement | null;
    if (box && boxImg) {
      document.querySelectorAll<HTMLImageElement>('img.zoomable').forEach((img) => {
        img.addEventListener('click', () => {
          boxImg.src = img.currentSrc || img.src;
          box.classList.add('open');
          box.setAttribute('aria-hidden', 'false');
        });
      });
      const close = () => {
        box.classList.remove('open');
        box.setAttribute('aria-hidden', 'true');
      };
      box.addEventListener('click', close);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    }
  </script>
</ArtLayout>
